  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "JWT token from tenant login"
    },
    {
      "key": "tenant_id",
      "value": "",
      "type": "string",
      "description": "Current authenticated tenant ID"
    },
    {
      "key": "theme_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "page_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "tax_id",
      "value": "",
      "type": "string"
