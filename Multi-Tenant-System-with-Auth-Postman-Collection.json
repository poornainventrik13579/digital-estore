  "item": [
    {
      "name": "🔐 Tenant Authentication",
      "description": "Tenant registration, login, and profile management",
      "item": [
        {
          "name": "1. Tenant Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.accessToken);",
                  "    pm.collectionVariables.set('tenant_id', response.tenantId);",
                  "    console.log('✅ Tenant registered successfully! Token saved.');",
                  "} else {",
                  "    console.log('❌ Signup failed:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"{{$randomCompanyName}} Store\",\n  \"shopEmail\": \"{{$randomEmail}}\",\n  \"password\": \"SecurePassword123\",\n  \"shopPhone\": \"+1-555-{{$randomInt}}\",\n  \"shopLogo\": \"https://example.com/logo-{{$randomInt}}.png\",\n  \"domainName\": \"{{$randomDomainWord}}.example.com\",\n  \"subdomain\": \"{{$randomDomainWord}}\",\n  \"countryRegion\": \"{{$randomCountry}}\",\n  \"baseCurrency\": \"USD\",\n  \"multiCurrency\": true,\n  \"taxId\": \"TX{{$randomInt}}\",\n  \"timezone\": \"America/New_York\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenant-auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenant-auth", "signup"]
            },
            "description": "Register a new tenant store and get JWT token"
          },
          "response": []
        },
        {
          "name": "2. Tenant Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.accessToken);",
                  "    pm.collectionVariables.set('tenant_id', response.tenantId);",
                  "    console.log('✅ Login successful! Token saved.');",
                  "} else {",
                  "    console.log('❌ Login failed:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testauth@example.com\",\n  \"password\": \"TestPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenant-auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenant-auth", "login"]
            },
            "description": "Login with tenant email and password"
          },
          "response": []
        },
        {
          "name": "3. Get Current Tenant Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tenant-auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenant-auth", "me"]
            },
            "description": "Get authenticated tenant's profile information"
          },
          "response": []
        },
