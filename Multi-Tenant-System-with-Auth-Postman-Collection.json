  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set Authorization header if JWT token exists",
          "const jwtToken = pm.collectionVariables.get('jwt_token');",
          "if (jwtToken && pm.request.auth.type !== 'noauth') {",
          "    pm.request.headers.add({",
          "        key: 'Authorization',",
          "        value: `Bearer ${jwtToken}`",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global response logging",
          "console.log(`🚀 ${pm.request.method} ${pm.request.url} → ${pm.response.code} ${pm.response.status}`);",
          "",
          "// Auto-save important response data",
          "if (pm.response.code < 400) {",
          "    try {",
          "        const response = pm.response.json();",
          "        ",
          "        // Save tenant ID if present",
          "        if (response.tenantId) {",
          "            pm.collectionVariables.set('tenant_id', response.tenantId);",
          "        }",
          "        ",
          "        // Save JWT token if present",
          "        if (response.accessToken) {",
          "            pm.collectionVariables.set('jwt_token', response.accessToken);",
          "        }",
          "    } catch (e) {",
          "        // Response might not be JSON",
          "    }",
          "} else {",
          "    console.log('❌ Request failed:', pm.response.text());",
          "}"
        ]
      }
    }
  ]
}
