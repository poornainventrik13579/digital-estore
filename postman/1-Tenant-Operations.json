{
	"info": {
		"_postman_id": "tenant-ops-001",
		"name": "Digital E-Store - Tenant Operations",
		"description": "Tenant management and configuration operations",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Tenant Signup with Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"tenant_id\", jsonData.tenantId);",
									"    pm.environment.set(\"admin_username\", jsonData.adminUsername);",
									"    console.log(\"Tenant ID: \" + jsonData.tenantId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"shopName\": \"TechWorld Electronics\",\n    \"shopEmail\": \"contact@techworld.com\",\n    \"shopPhone\": \"+1-555-1000\",\n    \"adminUsername\": \"techworld_admin\",\n    \"adminPassword\": \"Admin@2024\",\n    \"adminEmail\": \"admin@techworld.com\",\n    \"subdomain\": \"techworld\",\n    \"countryRegion\": \"United States\",\n    \"baseCurrency\": \"USD\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/tenant/signup",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "tenant", "signup"]
						}
					},
					"response": []
				},
				{
					"name": "Login as System Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"auth_token\", jsonData.token);",
									"    console.log(\"Token saved: \" + jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"response": []
				}
			]
		},
		{
