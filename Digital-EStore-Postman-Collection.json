							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "tenantId",
									"value": "{{tenant_id}}"
								},
								{
									"key": "username",
									"value": "{{username}}"
								},
								{
									"key": "email",
									"value": "{{username}}@example.com"
								},
								{
									"key": "password",
									"value": "{{user_password}}"
								},
								{
									"key": "firstName",
									"value": "Test"
								},
								{
									"key": "lastName",
									"value": "User"
								},
								{
									"key": "phone",
									"value": "1234567890"
								}
							]
						},
						"url": "{{base_url}}/api/v1/auth/signup"
					}
				}
