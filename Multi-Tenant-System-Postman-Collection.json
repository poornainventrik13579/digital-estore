            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started Guide\",\n  \"slug\": \"getting-started\",\n  \"content\": \"<h1>Getting Started</h1>\\n<p>Welcome to our digital store! Here's how to get started:</p>\\n<ol>\\n<li>Browse our product catalog</li>\\n<li>Add items to your cart</li>\\n<li>Complete secure checkout</li>\\n<li>Download your digital products instantly</li>\\n</ol>\",\n  \"metaTitle\": \"Getting Started Guide - Demo Digital Store\",\n  \"metaDescription\": \"Learn how to shop and download digital products from our store with this comprehensive getting started guide.\",\n  \"status\": \"DRAFT\",\n  \"visibility\": \"PUBLIC\",\n  \"isDefault\": false,\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/pages",
              "host": ["{{base_url}}"],
