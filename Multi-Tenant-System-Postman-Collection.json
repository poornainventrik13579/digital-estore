              "query": [
                {
                  "key": "baseAmount",
                  "value": "100.00"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Calculate Tax for Specific Date",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/taxes/calculate/date?baseAmount=100.00&date=2024-06-01",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "taxes", "calculate", "date"],
              "query": [
                {
                  "key": "baseAmount",
                  "value": "100.00"
                },
                {
                  "key": "date",
                  "value": "2024-06-01"
                }
              ]
            }
          },
          "response": []
