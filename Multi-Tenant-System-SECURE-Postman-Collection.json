{
  "info": {
    "name": "Multi-Tenant System SECURE (Updated)",
    "description": "SECURE API collection for Multi-Tenant Digital E-Store with FIXED security validation - ALL endpoints now require proper tenant authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "3.0.0"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{base_url}}/oauth2/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{base_url}}/oauth2/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "digital-estore-client",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "read write",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "JWT token from authentication (REQUIRED for security)"
    },
    {
      "key": "tenant_id",
      "value": "1",
      "type": "string",
      "description": "Authenticated tenant ID (validated by server)"
    },
    {
      "key": "subdomain",
      "value": "teststore",
      "type": "string",
      "description": "Tenant subdomain for Shopify-style URLs"
    }
  ],
  "item": [
    {
      "name": "🔐 AUTHENTICATION (Required First)",
      "item": [
        {
          "name": "Tenant Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"Test Store\",\n  \"shopEmail\": \"admin@teststore.com\",\n  \"domainName\": \"teststore\",\n  \"storePassword\": \"securePassword123\",\n  \"phoneNumber\": \"+1234567890\",\n  \"address\": \"123 Test Street\",\n  \"city\": \"Test City\",\n  \"state\": \"Test State\",\n  \"country\": \"Test Country\",\n  \"postalCode\": \"12345\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenant-auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenant-auth", "signup"]
            },
            "description": "Register a new tenant (store) - NO AUTH REQUIRED"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.token);",
                  "    pm.collectionVariables.set('tenant_id', response.tenantId);",
                  "    console.log('✅ Tenant signup successful - JWT token saved');",
                  "} else {",
                  "    console.log('❌ Tenant signup failed');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Tenant Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopEmail\": \"admin@teststore.com\",\n  \"storePassword\": \"securePassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenant-auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenant-auth", "login"]
            },
            "description": "Login as tenant admin - REQUIRED for accessing tenant data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.token);",
                  "    pm.collectionVariables.set('tenant_id', response.tenantId);",
                  "    console.log('✅ Tenant login successful - JWT token saved');",
                  "} else {",
                  "    console.log('❌ Tenant login failed');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🛡️ SECURE PRODUCT MANAGEMENT",
      "item": [
        {
          "name": "Get All Products (SECURED)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "REQUIRED - JWT token with tenant validation"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "products"]
            },
            "description": "🔒 SECURE: Only returns products for authenticated tenant"
          }
        },
        {
          "name": "Create Product (ADMIN ONLY)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "REQUIRED - Must be TENANT_ADMIN role"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Secure Test Product\",\n  \"description\": \"A product with proper security validation\",\n  \"price\": 99.99,\n  \"categoryId\": 1,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "products"]
            },
            "description": "🔒 SECURE: Only TENANT_ADMIN can create products for their tenant"
          }
        }
      ]
    },
    {
      "name": "🛡️ SECURE ORDER MANAGEMENT",
      "item": [
        {
          "name": "Get All Orders (ADMIN ONLY)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "REQUIRED - Must be TENANT_ADMIN"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "orders"]
            },
            "description": "🔒 SECURE: Only TENANT_ADMIN can view all orders for their tenant"
          }
        },
        {
          "name": "Get Order by ID (SECURED)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "REQUIRED - Tenant validation enforced"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/orders/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "orders", "1"]
            },
            "description": "🔒 SECURE: Can only access orders from authenticated tenant"
          }
        }
      ]
    },
    {
      "name": "🛡️ SECURE PAYMENT MANAGEMENT",
      "item": [
        {
          "name": "Get All Payments (CRITICAL SECURITY)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "CRITICAL - Payment data security enforced"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/payments",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "payments"]
            },
            "description": "🔒 CRITICAL SECURITY: Only TENANT_ADMIN can access payment data for their tenant"
          }
        },
        {
          "name": "Get Payment by ID (SECURED)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "REQUIRED - Prevents cross-tenant payment access"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/payments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "payments", "1"]
            },
            "description": "🔒 SECURE: Payment details protected by tenant validation"
          }
        }
      ]
    },
    {
      "name": "🎨 SHOPIFY-STYLE USER AUTH (New)",
      "item": [
        {
          "name": "User Signup to Store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"user@teststore.com\",\n  \"password\": \"userPassword123\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phone\": \"+1234567890\",\n  \"userType\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{subdomain}}/auth/users/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "{{subdomain}}", "auth", "users", "signup"]
            },
            "description": "Shopify-style user registration to specific store"
          }
        },
        {
          "name": "User Login to Store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@teststore.com\",\n  \"password\": \"userPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{subdomain}}/auth/users/login",
              "host": ["{{base_url}}"],
              "path": ["api", "{{subdomain}}", "auth", "users", "login"]
            },
            "description": "Shopify-style user login to specific store"
          }
        }
      ]
    },
    {
      "name": "📋 SECURITY TESTING",
      "item": [
        {
          "name": "❌ Test Cross-Tenant Access (Should FAIL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "Using tenant 1 JWT to access tenant 2 data"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/999/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "999", "products"]
            },
            "description": "🚨 SECURITY TEST: This should return 403 Forbidden due to tenant validation"
          }
        },
        {
          "name": "❌ Test No Auth (Should FAIL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "products"]
            },
            "description": "🚨 SECURITY TEST: This should return 401 Unauthorized"
          }
        }
      ]
    }
  ]
}
