              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME25\",\n  \"orderAmount\": 99.99\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/store/{{tenant_id}}/discounts/validate",
